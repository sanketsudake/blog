# Copy to `.env` (gitignored) and fill in. Both scripts/gen-og-image.py and
# scripts/analytics-report.py auto-load `.env` from the repo root.
# NEVER commit the real `.env` — only this example is tracked.

# Nano Banana (gemini-2.5-flash-image) background generation for OG images.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Analytics (see docs/analytics/SETUP.md). Numeric GA4 property id, not G-XXXX.
GA4_PROPERTY_ID=
GSC_SITE_URL=https://ssudake.com/
